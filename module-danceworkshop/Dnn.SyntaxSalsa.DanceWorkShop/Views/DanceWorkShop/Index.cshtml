@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage

<style>
    /* Alap konténer */
    .dance-workshop-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #413220;
        background-color: #f8f8f8;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
        border-bottom: 1px solid #c9b9a4;
        padding-bottom: 15px;
    }

        .calendar-header h2 {
            font-weight: 300;
            color: #413220;
            margin: 0;
        }

    .calendar-controls {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    /* Gombok stílusa */
    .dnnPrimaryAction, #btn-this-week {
        background-color: #413220 !important;
        border-color: #413220 !important;
        color: white !important;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }

    .dnnSecondaryAction {
        background-color: #858e9d !important;
        border-color: #858e9d !important;
        color: white !important;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }

    #jump-to-week {
        padding: 6px 12px;
        border: 1px solid #c9b9a4;
        border-radius: 4px;
        color: #413220;
    }

    button:disabled {
        opacity: 0.3 !important;
        cursor: not-allowed !important;
    }

    /* Táblázat */
    .calendar-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px;
        table-layout: fixed;
    }

        .calendar-table th {
            background: #c9b9a4;
            color: white;
            padding: 12px 5px;
            font-size: 0.85em;
            text-transform: uppercase;
            text-align: center;
            border-radius: 4px;
        }

        .calendar-table td {
            height: 85px;
            background: white;
            border: 1px solid #eee;
            border-radius: 4px;
            vertical-align: middle;
            text-align: center;
            padding: 5px;
            font-size: 0.9em;
            transition: all 0.2s;
        }

    /* KRÉMES SZÍNKÓDOK */
    .dw-slot-past {
        background-color: #f1ede8 !important;
        color: #c9b9a4;
        cursor: not-allowed;
    }

    .dw-slot-free {
        background-color: white !important;
        color: #858e9d;
        border: 2px solid #858e9d !important;
        font-weight: bold;
        cursor: pointer;
    }

    .dw-slot-full {
        background-color: #413220 !important;
        color: #f8f8f8;
        font-weight: normal;
        cursor: not-allowed;
    }

    .dw-slot-own {
        background-color: #c9b9a4 !important;
        color: white;
        border: 2px solid #413220 !important;
        font-weight: bold;
        cursor: pointer;
    }

    .dw-slot-none {
        color: #f0f0f0;
    }

    .btn-admin-link {
        background-color: #c9b9a4;
        color: white !important;
        padding: 8px 12px;
        border-radius: 4px;
        text-decoration: none !important;
        font-size: 0.85em;
        font-weight: bold;
    }
</style>

<div id="workshop-calendar-@Dnn.ModuleContext.ModuleId" class="dance-workshop-container">
    <div class="calendar-header">
        <h2 id="calendar-title"></h2>
        <div class="calendar-controls">
            <button type="button" id="btn-prev-week" class="dnnSecondaryAction">Előző hét</button>
            <button type="button" id="btn-this-week" class="dnnPrimaryAction">Aktuális hét</button>
            <button type="button" id="btn-next-week" class="dnnSecondaryAction">Következő hét</button>
            <select id="jump-to-week"></select>

            @if (Dnn.ModuleContext.IsEditable)
            {
                <a href="@Url.Action("Management", "DanceWorkshop")" class="btn-admin-link">⚙ Admin kontrol</a>
            }
        </div>
    </div>

    <div class="calendar-scroll" style="overflow-x: auto;">
        <table class="dnnTable calendar-table">
            <thead>
                <tr id="calendar-days">
                    <th style="width: 120px;">Időpont<br /><small>(Helyi / UTC)</small></th>
                </tr>
            </thead>
            <tbody id="calendar-slots"></tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var apiRoot = sf.getServiceRoot('DanceWorkShop') + "DanceWorkshopApi/";
        var currentWeekOffset = 0;

        function getStartOfWeek(offset) {
            var now = new Date();
            var day = now.getDay() || 7;
            var monday = new Date(now);
            monday.setDate(now.getDate() - day + 1 + (offset * 7));
            monday.setHours(0, 0, 0, 0);
            return monday;
        }

        function updateButtonStates() {
            //  szerinti gombkezelés
            $("#btn-prev-week").prop("disabled", currentWeekOffset <= 0);
            $("#btn-this-week").prop("disabled", currentWeekOffset === 0);
            $("#btn-next-week").prop("disabled", currentWeekOffset >= 52);
        }

        function populateJumpToWeek() {
            var $select = $("#jump-to-week");
            $select.empty();
            // 52 hét előre
            for (var i = 0; i <= 52; i++) {
                var start = getStartOfWeek(i);
                var label = start.toLocaleDateString('hu-HU', { month: 'short', day: 'numeric' });
                var option = $("<option>").val(i).text(label + "-i hét");
                if (i === currentWeekOffset) option.attr("selected", "selected");
                $select.append(option);
            }
        }

        function renderCalendar() {
            var start = getStartOfWeek(currentWeekOffset);
            var end = new Date(start);
            end.setDate(start.getDate() + 6);

            $("#calendar-title").text(start.toLocaleDateString('hu-HU') + " - " + end.toLocaleDateString('hu-HU'));
            $("#calendar-days").find("th:gt(0)").remove();
            $("#calendar-slots").empty();

            for (var i = 0; i < 7; i++) {
                var d = new Date(start);
                d.setDate(start.getDate() + i);
                $("#calendar-days").append("<th>" + d.toLocaleDateString('hu-HU', { weekday: 'short', month: 'short', day: 'numeric' }) + "</th>");
            }

            populateJumpToWeek();
            updateButtonStates();

            $.ajax({
                url: apiRoot + "SessionsList",
                method: "GET",
                data: { year: start.getFullYear(), week: currentWeekOffset },
                beforeSend: sf.setModuleHeaders
            }).done(function (sessions) {
                for (var hour = 8; hour <= 20; hour++) {
                    var row = $("<tr>");

                    // UTC idők kijelzése
                    var offset = new Date().getTimezoneOffset() / 60;
                    var utcHour = hour + offset;
                    row.append("<td style='background:#f9f9f9;'><b>" + hour + ":00</b><br/><small>UTC: " + (utcHour < 10 ? "0" + utcHour : utcHour) + ":00</small></td>");

                    for (var day = 0; day < 7; day++) {
                        var slotDate = new Date(start);
                        slotDate.setDate(start.getDate() + day);
                        slotDate.setHours(hour, 0, 0, 0);

                        var cell = $("<td>").addClass("calendar-cell");
                        applySlotStyle(cell, slotDate, sessions);
                        row.append(cell);
                    }
                    $("#calendar-slots").append(row);
                }
            });
        }

        function applySlotStyle(cell, slotDate, sessions) {
            var now = new Date();
            var diffHours = (slotDate - now) / (1000 * 60 * 60);

            var session = sessions ? sessions.find(s => new Date(s.Start).getTime() === slotDate.getTime()) : null;

            // 1. Saját foglalás
            if (session && session.UserBookingID > 0) {
                cell.addClass("dw-slot-own").html("SAJÁT").on("click", function() {
                    openModal(session.SessionID, true); // Nézegető mód [cite: 29, 152]
                });
            }
            // 2. Múltbeli vagy 24 órán belüli [cite: 22, 27, 127]
            else if (slotDate < now || diffHours < 24) {
                cell.addClass("dw-slot-past").text(session ? (session.IsFull ? "Betelt" : "Zárt") : "-");
            }
            // 3. Nincs óra
            else if (!session) {
                cell.addClass("dw-slot-none").text("-");
            }
            // 4. Betelt [cite: 21, 126]
            else if (session.IsFull) {
                cell.addClass("dw-slot-full").text("Betelt");
            }
            // 5. Szabad [cite: 21, 129]
            else {
                cell.addClass("dw-slot-free").html("SZABAD").on("click", function() {
                    openModal(session.SessionID, false); // Szerkesztő mód [cite: 23, 140]
                });
            }
        }

        function openModal(sessionId, isViewer) {
            var url = "@Url.Action("Edit", "DanceWorkshop")";
            dnnModal.show(url + "?mid=" + mid + "&sessionId=" + sessionId + "&view=" + isViewer, false, 450, 550, true);
        }

        $("#btn-prev-week").click(function() { if(currentWeekOffset > 0) { currentWeekOffset--; renderCalendar(); } });
        $("#btn-next-week").click(function() { if(currentWeekOffset < 52) { currentWeekOffset++; renderCalendar(); } });
        $("#btn-this-week").click(function() { currentWeekOffset = 0; renderCalendar(); });
        $("#jump-to-week").change(function() { currentWeekOffset = parseInt($(this).val()); renderCalendar(); });

        renderCalendar();
    });
</script>