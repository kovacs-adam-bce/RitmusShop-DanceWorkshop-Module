@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage
@using DotNetNuke.Framework.JavaScriptLibraries

@{
    JavaScript.RequestRegistration(CommonJs.jQuery);
    JavaScript.RequestRegistration(CommonJs.jQueryMigrate);
    JavaScript.RequestRegistration(CommonJs.DnnPlugins);
}

<style>
    .dance-workshop-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #413220;
        background-color: #f8f8f8;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
        border-bottom: 1px solid #c9b9a4;
        padding-bottom: 15px;
    }

        .calendar-header h2 {
            font-weight: 300;
            color: #413220;
            margin: 0;
        }

    .calendar-controls {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: nowrap;
    }

    .dnnPrimaryAction, #btn-this-week {
        background-color: #413220 !important;
        color: white !important;
        padding: 8px 16px;
        border-radius: 4px;
        white-space: nowrap;
        cursor: pointer;
    }

    .dnnSecondaryAction {
        background-color: #6d5941 !important;
        color: white !important;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color 0.2s
    }

        .dnnSecondaryAction:hover {
            background-color: #856e54 !important;
        }

    

    #jump-to-week {
        padding: 6px 12px;
        border: 1px solid #c9b9a4;
        border-radius: 4px;
        color: #413220;
    }

    button:disabled {
        opacity: 0.3 !important;
        cursor: not-allowed !important;
    }

    .calendar-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px;
        table-layout: fixed;
    }

        .calendar-table th {
            background: #c9b9a4;
            color: white;
            padding: 12px 5px;
            font-size: 0.85em;
            text-transform: uppercase;
            text-align: center;
            border-radius: 4px;
        }

        .calendar-table td {
            height: 85px;
            background: white;
            border: 1px solid #eee;
            border-radius: 4px;
            vertical-align: middle;
            text-align: center;
            padding: 5px;
            font-size: 0.9em;
        }

    .dw-slot-past {
        background-color: #f1ede8 !important;
        color: #c9b9a4;
        cursor: not-allowed;
    }

    .dw-slot-free {
        background-color: white !important;
        color: #858e9d;
        border: 2px solid #858e9d !important;
        font-weight: bold;
        cursor: pointer;
    }

    .dw-slot-full {
        background-color: #413220 !important;
        color: #f8f8f8;
        font-weight: normal;
        cursor: not-allowed;
    }

    .dw-slot-own {
        background-color: #c9b9a4 !important;
        color: white;
        border: 2px solid #413220 !important;
        font-weight: bold;
        cursor: pointer;
    }

    .dw-slot-none {
        color: #f0f0f0;
    }

    .btn-admin-link {
        background-color: #c9b9a4;
        color: white !important;
        padding: 8px 12px;
        border-radius: 4px;
        text-decoration: none !important;
        font-size: 0.85em;
        font-weight: bold;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
</style>

<div id="workshop-calendar-@Dnn.ModuleContext.ModuleId" class="dance-workshop-container">
    <div class="calendar-header">
        <h2 id="calendar-title">Naptár betöltése...</h2>
        <div class="calendar-controls">
            <button type="button" id="btn-prev-week" class="dnnSecondaryAction">Előző hét</button>
            <button type="button" id="btn-this-week" class="dnnPrimaryAction">Aktuális hét</button>
            <button type="button" id="btn-next-week" class="dnnSecondaryAction">Következő hét</button>
            <select id="jump-to-week"></select>
            @if (Request.IsAuthenticated && (Dnn.User.IsSuperUser || Dnn.User.IsInRole(Dnn.PortalSettings.AdministratorRoleName) || Dnn.ModuleContext.IsEditable))
            {
                <a href="@Url.Action("Management", "DanceWorkshop")" class="btn-admin-link">⚙ Management</a>
            }
        </div>
    </div>

    <div class="calendar-scroll" style="overflow-x: auto;">
        <table class="dnnTable calendar-table">
            <thead>
                <tr id="calendar-days">
                    <th style="width: 120px;">Időpont<br /><small>(Helyi / UTC)</small></th>
                </tr>
            </thead>
            <tbody id="calendar-slots">
                <tr><td colspan="8" style="padding: 30px; text-align: center;">Várakozás az adatokra...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var serviceRoot = 'YourRFProject/module-danceworkshop/Dnn.SyntaxSalsa.DanceWorkShop';
        var apiRoot = sf.getServiceRoot(serviceRoot) + "DanceWorkshopApi/";
        var currentWeekOffset = 0;

        function getStartOfWeek(offset) {
            var now = new Date();
            var day = now.getDay() || 7;
            var monday = new Date(now);
            monday.setDate(now.getDate() - day + 1 + (offset * 7));
            monday.setHours(0, 0, 0, 0);
            return monday;
        }

        function populateJumpToWeek() {
            var $select = $("#jump-to-week");
            $select.empty();
            for (var i = 0; i <= 52; i++) {
                var start = getStartOfWeek(i);
                $select.append($("<option>").val(i).text(start.toLocaleDateString('hu-HU', { month: 'short', day: 'numeric' }) + "-i hét"));
            }
            $select.val(currentWeekOffset);
        }

        function renderCalendar() {
            var start = getStartOfWeek(currentWeekOffset);
            var end = new Date(start);
            end.setDate(start.getDate() + 6);

            $("#calendar-title").text(start.toLocaleDateString('hu-HU') + " - " + end.toLocaleDateString('hu-HU'));
            $("#calendar-days").find("th:gt(0)").remove();
            for (var i = 0; i < 7; i++) {
                var d = new Date(start);
                d.setDate(start.getDate() + i);
                $("#calendar-days").append("<th>" + d.toLocaleDateString('hu-HU', { weekday: 'short', month: 'short', day: 'numeric' }) + "</th>");
            }

            $("#btn-prev-week").prop("disabled", currentWeekOffset <= 0);
            $("#btn-next-week").prop("disabled", currentWeekOffset >= 52);
            populateJumpToWeek();

            $.ajax({
                url: apiRoot + "SessionsList",
                method: "GET",
                data: { year: start.getFullYear(), week: currentWeekOffset },
                beforeSend: sf.setModuleHeaders
            }).done(function (sessions) {
                $("#calendar-slots").empty();
                for (var hour = 8; hour <= 20; hour++) {
                    var row = $("<tr>");
                    var offset = new Date().getTimezoneOffset() / 60;
                    var utcHour = hour + offset;
                    row.append("<td style='background:#f9f9f9;'><b>" + hour + ":00</b><br/><small>UTC: " + (utcHour < 10 ? "0" + utcHour : utcHour) + ":00</small></td>");

                    for (var day = 0; day < 7; day++) {
                        var slotDate = new Date(start);
                        slotDate.setDate(start.getDate() + day);
                        slotDate.setHours(hour, 0, 0, 0);
                        var cell = $("<td>").addClass("calendar-cell");
                        applySlotStyle(cell, slotDate, sessions);
                        row.append(cell);
                    }
                    $("#calendar-slots").append(row);
                }
            }).fail(function(xhr) {
                $("#calendar-slots").html("<tr><td colspan='8' style='color:red; padding:20px;'>Hiba: " + xhr.status + "</td></tr>");
            });
        }

        function applySlotStyle(cell, slotDate, sessions) {
            var now = new Date();
            var diffHours = (slotDate - now) / (1000 * 60 * 60);
            var session = sessions ? sessions.find(s => new Date(s.Start).getTime() === slotDate.getTime()) : null;

            if (session && session.UserBookingID > 0) {
                // JAVÍTÁS: Itt a foglalás ID-t (UserBookingID) adjuk át a lemondáshoz, nem a SessionID-t!
                cell.addClass("dw-slot-own").html("SAJÁT").on("click", function () {
                    openModal(session.UserBookingID, true, slotDate);
                });
            }
            else if (slotDate < now || diffHours < 24) {
                cell.addClass("dw-slot-past").text(session ? (session.IsFull ? "Betelt" : "Zárt") : "-");
            }
            else if (!session) {
                cell.addClass("dw-slot-none").text("-");
            }
            else if (session.IsFull) {
                cell.addClass("dw-slot-full").text("Betelt");
            }
            else {
                var content = "<strong>" + (session.WorkshopName || "SZABAD") + "</strong>";
                if (session.WorkshopLevel) {
                    content += "<br/><small>(" + session.WorkshopLevel + ")</small>";
                }
                cell.addClass("dw-slot-free").html(content).on("click", function () {
                    openModal(session.SessionID, false, slotDate);
                });
            }
        }

        function openModal(id, isViewer, slotDate) {
            var url = "@Url.Action("Edit", "DanceWorkshop")";
            var dateStr = encodeURIComponent(slotDate.toISOString());
            // Itt az 'id' vagy SessionID (foglaláskor), vagy UserBookingID (lemondáskor)
            dnnModal.show(url + "?mid=" + mid + "&sessionId=" + id + "&view=" + isViewer + "&d=" + dateStr, false, 450, 550, true);
        }

        $("#btn-prev-week").click(function() { if(currentWeekOffset > 0) { currentWeekOffset--; renderCalendar(); } });
        $("#btn-next-week").click(function() { if(currentWeekOffset < 52) { currentWeekOffset++; renderCalendar(); } });
        $("#btn-this-week").click(function() { currentWeekOffset = 0; renderCalendar(); });
        $("#jump-to-week").change(function() { currentWeekOffset = parseInt($(this).val()); renderCalendar(); });

        renderCalendar();
    });
</script>