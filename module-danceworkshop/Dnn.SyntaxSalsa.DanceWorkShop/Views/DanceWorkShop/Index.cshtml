@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage

<style>
    /* Alap konténer a megadott törtfehér háttérrel */
    .dance-workshop-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #413220;
        background-color: #f8f8f8;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .calendar-header h2 {
            font-weight: 300;
            color: #413220;
            letter-spacing: 1px;
            margin: 0;
        }

    /* Gombok és a legördülő mező stílusa */
    .calendar-controls {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .dnnPrimaryAction, #btn-this-week {
        background-color: #413220 !important;
        border-color: #413220 !important;
        color: white !important;
        border-radius: 4px;
    }

    .dnnSecondaryAction {
        background-color: #858e9d !important;
        border-color: #858e9d !important;
        color: white !important;
        border-radius: 4px;
    }

    #jump-to-week {
        padding: 6px 12px;
        border: 1px solid #c9b9a4;
        border-radius: 4px;
        background-color: white;
        color: #413220;
    }

    /* Táblázat a kért középre igazítással */
    .calendar-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px;
        table-layout: fixed;
    }

        .calendar-table th {
            background: #c9b9a4;
            color: white;
            padding: 15px 5px;
            border: none;
            font-size: 0.85em;
            text-transform: uppercase;
            text-align: center;
            border-radius: 4px;
        }

        .calendar-table td {
            height: 85px;
            background: white;
            border: 1px solid #eee;
            border-radius: 4px;
            transition: all 0.3s ease;
            vertical-align: middle;
            text-align: center;
            padding: 5px;
            font-size: 0.9em;
        }

    /* Állapotok a paletta alapján */
    .dw-slot-past {
        background-color: #f1ede8 !important;
        color: #c9b9a4;
        cursor: not-allowed;
    }

    .dw-slot-none {
        background-color: #ffffff !important;
        color: #e0e0e0;
        font-style: italic;
    }

    .dw-slot-free {
        background-color: white !important;
        color: #858e9d;
        border: 2px solid #858e9d !important;
        font-weight: bold;
        cursor: pointer;
    }

        .dw-slot-free:hover {
            background-color: #858e9d !important;
            color: white;
            transform: translateY(-2px);
        }

    .dw-slot-full {
        background-color: #413220 !important;
        color: #f8f8f8;
    }

    .dw-slot-own {
        background-color: #c9b9a4 !important;
        color: white;
    }
</style>

<div id="workshop-calendar-@Dnn.ModuleContext.ModuleId" class="dance-workshop-container">
    <div class="calendar-header">
        <h2 id="calendar-title">Workshopok</h2>
        <div class="calendar-controls">
            <button type="button" id="btn-prev-week" class="dnnSecondaryAction">Előző</button>
            <button type="button" id="btn-this-week" class="dnnPrimaryAction">Ma</button>
            <button type="button" id="btn-next-week" class="dnnSecondaryAction">Következő</button>
            <select id="jump-to-week"></select>
        </div>
    </div>

    <div class="calendar-scroll" style="overflow-x: auto;">
        <table class="dnnTable calendar-table">
            <thead>
                <tr id="calendar-days">
                    <th style="width: 100px;">Időpont</th>
                </tr>
            </thead>
            <tbody id="calendar-slots"></tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var apiRoot = sf.getServiceRoot('DanceWorkShop') + "DanceWorkshopApi/";
        var currentWeekOffset = 0;

        function getStartOfWeek(offset) {
            var now = new Date();
            var day = now.getDay() || 7;
            var monday = new Date(now);
            monday.setDate(now.getDate() - day + 1 + (offset * 7));
            monday.setHours(0, 0, 0, 0);
            return monday;
        }

        function populateJumpToWeek() {
            var $select = $("#jump-to-week");
            $select.empty();
            for (var i = -2; i <= 12; i++) {
                var start = getStartOfWeek(i);
                var label = start.toLocaleDateString('hu-HU', { month: 'short', day: 'numeric' });
                var option = $("<option>").val(i).text(label + "-i hét");
                if (i === currentWeekOffset) option.attr("selected", "selected");
                $select.append(option);
            }
        }

        function renderCalendar() {
            var start = getStartOfWeek(currentWeekOffset);
            var end = new Date(start);
            end.setDate(start.getDate() + 6);

            $("#calendar-title").text(start.toLocaleDateString() + " - " + end.toLocaleDateString());
            $("#calendar-days").find("th:gt(0)").remove();
            $("#calendar-slots").empty();

            for (var i = 0; i < 7; i++) {
                var d = new Date(start);
                d.setDate(start.getDate() + i);
                $("#calendar-days").append("<th>" + d.toLocaleDateString('hu-HU', { weekday: 'short', month: 'short', day: 'numeric' }) + "</th>");
            }

            populateJumpToWeek();

            $.ajax({
                url: apiRoot + "SessionsList",
                method: "GET",
                data: { year: start.getFullYear(), week: 1 },
                beforeSend: sf.setModuleHeaders
            }).done(function (sessions) {
                for (var hour = 8; hour <= 20; hour++) {
                    var row = $("<tr>");
                    row.append("<td style='background:#f9f9f9;'><b>" + hour + ":00</b></td>");

                    for (var day = 0; day < 7; day++) {
                        var slotDate = new Date(start);
                        slotDate.setDate(start.getDate() + day);
                        slotDate.setHours(hour, 0, 0, 0);

                        var cell = $("<td>").addClass("calendar-cell");
                        applySlotStyle(cell, slotDate, sessions);
                        row.append(cell);
                    }
                    $("#calendar-slots").append(row);
                }
            });
        }

        function applySlotStyle(cell, slotDate, sessions) {
            var now = new Date();
            var diffHours = (slotDate - now) / (1000 * 60 * 60);

            var session = null;
            if (sessions && sessions.length) {
                for (var i = 0; i < sessions.length; i++) {
                    if (new Date(sessions[i].Start).getTime() === slotDate.getTime()) {
                        session = sessions[i];
                        break;
                    }
                }
            }

            if (slotDate < now || diffHours < 24) {
                cell.addClass("dw-slot-past").text("Zárt");
            } else if (!session) {
                cell.addClass("dw-slot-none").text("-");
            } else if (session.IsFull) {
                cell.addClass("dw-slot-full").text("Betelt");
            } else {
                cell.addClass("dw-slot-free").html("SZABAD").on("click", function() {
                    var url = "@Url.Action("Edit", "DanceWorkshop")";
                    dnnModal.show(url + "?mid=" + mid + "&sessionId=" + session.SessionID, false, 400, 550, true);
                });
            }
        }

        $("#btn-prev-week").click(function() { currentWeekOffset--; renderCalendar(); });
        $("#btn-next-week").click(function() { currentWeekOffset++; renderCalendar(); });
        $("#btn-this-week").click(function() { currentWeekOffset = 0; renderCalendar(); });
        $("#jump-to-week").change(function() { currentWeekOffset = parseInt($(this).val()); renderCalendar(); });

        renderCalendar();
    });
</script>