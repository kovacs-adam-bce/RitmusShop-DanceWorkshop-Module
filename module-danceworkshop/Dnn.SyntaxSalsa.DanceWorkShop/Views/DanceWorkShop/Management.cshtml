@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage
@using DotNetNuke.Framework.JavaScriptLibraries


@{
    JavaScript.RequestRegistration(CommonJs.DnnPlugins);
    JavaScript.RequestRegistration(CommonJs.jQuery);
}

<style>
    .mgmt-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #413220;
        background-color: #f8f8f8;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .mgmt-header {
        border-bottom: 2px solid #c9b9a4;
        margin-bottom: 25px;
        padding-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .mgmt-header h2 {
            color: #413220;
            font-weight: 300;
            text-transform: uppercase;
            margin: 0;
        }

    .mgmt-grid {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .mgmt-card {
        background: white;
        padding: 25px;
        border-radius: 8px;
        flex: 1;
        min-width: 350px;
        border: 1px solid #eee;
    }

        .mgmt-card h3 {
            border-bottom: 1px solid #f1ede8;
            padding-bottom: 12px;
            margin-top: 0;
            color: #858e9d;
            font-size: 1.1em;
            text-transform: uppercase;
        }

    .mgmt-form-item {
        margin-bottom: 18px;
    }

        .mgmt-form-item label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            font-size: 0.85em;
            color: #413220;
        }

    .mgmt-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #c9b9a4;
        border-radius: 4px;
        box-sizing: border-box;
    }

    .btn-save-ws {
        background-color: #413220 !important;
        color: white !important;
        border: none;
        padding: 12px 20px;
        border-radius: 4px;
        cursor: pointer;
        width: 100%;
        font-weight: bold;
    }

    .btn-save-session {
        background-color: #858e9d !important;
        color: white !important;
        border: none;
        padding: 12px 20px;
        border-radius: 4px;
        cursor: pointer;
        width: 100%;
        font-weight: bold;
    }

    .mgmt-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 15px;
    }

        .mgmt-table th {
            background-color: #c9b9a4;
            color: white;
            padding: 15px;
            text-align: left;
            font-size: 0.8em;
            text-transform: uppercase;
        }

        .mgmt-table td {
            padding: 15px;
            border-bottom: 1px solid #f1ede8;
            font-size: 0.9em;
        }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75em;
        font-weight: bold;
    }

    .status-active {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-cancelled {
        background-color: #ffebee;
        color: #c62828;
    }

    .btn-delete {
        color: #dc3545;
        cursor: pointer;
        background: none;
        border: 1px solid #dc3545;
        padding: 4px 8px;
        border-radius: 4px;
    }
</style>

<div class="mgmt-container">
    <div class="mgmt-header">
        <h2>Workshop Kezelés</h2>
        <a href="@Url.Action("Index", "DanceWorkshop")" style="color: #858e9d; text-decoration: none; font-size: 0.9em;">← Vissza a naptárhoz</a>
    </div>

    <div class="mgmt-grid">
        <div class="mgmt-card">
            <h3>Új Workshop</h3>
            <div class="mgmt-form-item">
                <label>Workshop neve:</label>
                <input type="text" id="new-ws-name" class="mgmt-input" />
            </div>
            <div class="mgmt-form-item">
                <label>Szint:</label>
                <input type="text" id="new-ws-level" class="mgmt-input" />
            </div>
            <button type="button" id="btn-save-workshop" class="btn-save-ws">Mentés</button>
        </div>

        <div class="mgmt-card">
            <h3>Időpont meghirdetése</h3>
            <div class="mgmt-form-item">
                <label>Workshop:</label>
                <select id="session-ws-id" class="mgmt-input"></select>
            </div>
            <div class="mgmt-form-item">
                <label>Kezdés:</label>
                <input type="datetime-local" id="session-start" class="mgmt-input" />
            </div>
            <button type="button" id="btn-save-session" class="btn-save-session">Rögzítés</button>
        </div>
    </div>

    <div class="mgmt-table-section">
        <h3>Foglalási riport</h3>
        <table class="mgmt-table">
            <thead>
                <tr>
                    <th>Időpont</th>
                    <th>Workshop</th>
                    <th>Résztvevő</th>
                    <th>Állapot</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody id="admin-booking-list"></tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var apiRoot = sf.getServiceRoot('YourRFProject/module-danceworkshop/Dnn.SyntaxSalsa.DanceWorkShop') + "DanceWorkshopApi/";

        function loadData() {

            $.ajax({ url: apiRoot + "WorkshopsList", method: "GET", beforeSend: sf.setModuleHeaders }).done(function(data) {
                var $s = $("#session-ws-id").empty().append("<option value=''>-- Válassz --</option>");
                $.each(data, function(i, v) { $s.append($("<option>").val(v.WorkshopID).text(v.Name)); });
            });


            $.ajax({ url: apiRoot + "GetAllBookings", method: "GET", beforeSend: sf.setModuleHeaders }).done(function(data) {
                var $b = $("#admin-booking-list").empty();
                if(!data || data.length === 0) {
                    $b.append("<tr><td colspan='5' style='text-align:center; padding:20px;'>Nincs foglalás.</td></tr>");
                    return;
                }
                $.each(data, function(i, v) {
                    var s = v.IsCancelled ? "status-cancelled" : "status-active";
                    $b.append("<tr><td>"+new Date(v.SessionStart).toLocaleString('hu-HU')+"</td><td>"+v.WorkshopName+"</td><td>"+v.Username+"</td><td><span class='status-badge "+s+"'>"+(v.IsCancelled ? "Zárt" : "Aktív")+"</span></td><td>"+(!v.IsCancelled ? "<button class='btn-delete' onclick='cancelBooking(" + v.BookingID + ")'>Törlés</button>" : "-")+"</td></tr>");
                });
            });
        }


        $("#btn-save-workshop").click(function() {
            var name = $("#new-ws-name").val();
            if(!name) { alert("A név kötelező!"); return; }
            var d = { Name: name, Level: $("#new-ws-level").val(), Price: 0, Description: "Admin" };
            $.ajax({ url: apiRoot + "SaveWorkshop", method: "POST", data: d, beforeSend: sf.setModuleHeaders }).done(function() {
                alert("Workshop mentve!");
                $("#new-ws-name, #new-ws-level").val("");
                loadData();
            });
        });


        $("#btn-save-session").click(function() {
            var wsId = $("#session-ws-id").val();
            var start = $("#session-start").val();
            if(!wsId || !start) { alert("Válassz workshopot és időpontot!"); return; }

            var d = { WorkshopID: wsId, Start: start, Capacity: 10 };
            $.ajax({ url: apiRoot + "SaveSession", method: "POST", data: d, beforeSend: sf.setModuleHeaders }).done(function() {
                alert("Időpont rögzítve!");
                $("#session-start").val("");
                loadData();
            });
        });


        window.cancelBooking = function(id) {
            if(confirm("Biztosan törlöd ezt a foglalást?")) {
                $.ajax({ url: apiRoot + "CancelBooking/" + id, method: "POST", beforeSend: sf.setModuleHeaders }).done(function() { loadData(); });
            }
        };

        loadData();
    });
</script>