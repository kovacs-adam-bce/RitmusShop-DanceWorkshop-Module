@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage
@using DotNetNuke.Framework.JavaScriptLibraries

@{
    // Scriptek és AJAX támogatás regisztrációja
    JavaScript.RequestRegistration(CommonJs.jQuery);
    JavaScript.RequestRegistration(CommonJs.DnnPlugins);
    DotNetNuke.Framework.ServicesFramework.Instance.RequestAjaxScriptSupport();
}

<style>
    .mgmt-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #413220;
        background-color: #f8f8f8;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .mgmt-header {
        border-bottom: 2px solid #c9b9a4;
        margin-bottom: 25px;
        padding-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .mgmt-header h2 {
            color: #413220;
            font-weight: 300;
            text-transform: uppercase;
            margin: 0;
        }

    .mgmt-grid {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .mgmt-card {
        background: white;
        padding: 25px;
        border-radius: 8px;
        flex: 1;
        min-width: 350px;
        border: 1px solid #eee;
    }

        .mgmt-card h3 {
            border-bottom: 1px solid #f1ede8;
            padding-bottom: 12px;
            margin-top: 0;
            color: #858e9d;
            font-size: 1.1em;
            text-transform: uppercase;
        }

    .mgmt-form-item {
        margin-bottom: 18px;
    }

        .mgmt-form-item label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            font-size: 0.85em;
            color: #413220;
        }

    .mgmt-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #c9b9a4;
        border-radius: 4px;
        box-sizing: border-box;
    }

    .btn-save-ws {
        background-color: #413220 !important;
        color: white !important;
        border: none;
        padding: 12px 20px;
        border-radius: 4px;
        cursor: pointer;
        width: 100%;
        font-weight: bold;
    }

    .btn-save-session {
        background-color: #858e9d !important;
        color: white !important;
        border: none;
        padding: 12px 20px;
        border-radius: 4px;
        cursor: pointer;
        width: 100%;
        font-weight: bold;
    }

    .mgmt-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 15px;
    }

        .mgmt-table th {
            background-color: #c9b9a4;
            color: white;
            padding: 15px;
            text-align: left;
            font-size: 0.8em;
            text-transform: uppercase;
        }

        .mgmt-table td {
            padding: 15px;
            border-bottom: 1px solid #f1ede8;
            font-size: 0.9em;
        }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75em;
        font-weight: bold;
    }

    .status-active {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-cancelled {
        background-color: #ffebee;
        color: #c62828;
    }

    .btn-delete {
        color: #dc3545;
        cursor: pointer;
        background: none;
        border: 1px solid #dc3545;
        padding: 4px 8px;
        border-radius: 4px;
    }

    #mgmt-search {
        margin-bottom: 15px;
        border: 2px solid #c9b9a4;
        font-weight: bold;
    }
</style>

<div class="mgmt-container">
    <div class="mgmt-header">
        <h2>Workshop Kezelés</h2>
        <a href="@Url.Action("Index", "DanceWorkshop")" style="color: #858e9d; text-decoration: none; font-size: 0.9em;">← Vissza a naptárhoz</a>
    </div>

    <div class="mgmt-grid">
        @* Új Workshop *@
        <div class="mgmt-card">
            <h3>Új Workshop létrehozása</h3>
            <div class="mgmt-form-item">
                <label>Workshop neve:</label>
                <input type="text" id="new-ws-name" class="mgmt-input" />
            </div>
            <div class="mgmt-form-item">
                <label>Szint (nehézség):</label>
                <input type="text" id="new-ws-level" class="mgmt-input" placeholder="pl. Kezdő, Haladó" />
            </div>
            <button type="button" id="btn-save-workshop" class="btn-save-ws">Mentés</button>
        </div>

        @* Időpont meghirdetése *@
        <div class="mgmt-card">
            <h3>Időpont (Session) meghirdetése</h3>
            <div class="mgmt-form-item">
                <label>Workshop kiválasztása:</label>
                <select id="session-ws-id" class="mgmt-input"></select>
            </div>
            <div class="mgmt-form-item">
                <label>Kezdés (Csak egész óra!):</label>
                <input type="datetime-local" id="session-start" class="mgmt-input" />
            </div>
            <div class="mgmt-form-item">
                <label>Maximum létszám (fő):</label>
                <input type="number" id="session-capacity" class="mgmt-input" value="10" min="1" />
            </div>
            <button type="button" id="btn-save-session" class="btn-save-session">Rögzítés</button>
        </div>
    </div>

    <div class="mgmt-table-section">
        <h3>Foglalási riport</h3>
        <input type="text" id="mgmt-search" class="mgmt-input" placeholder="Keresés résztvevő neve alapján..." />

        <table class="mgmt-table">
            <thead>
                <tr>
                    <th>Időpont</th>
                    <th>Workshop (Szint)</th>
                    <th>Résztvevő</th>
                    <th>Állapot</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody id="admin-booking-list">
                <tr><td colspan="5" style="text-align:center; padding:20px;">Adatok betöltése...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var apiRoot = sf.getServiceRoot('YourRFProject/module-danceworkshop/Dnn.SyntaxSalsa.DanceWorkShop') + "DanceWorkshopApi/";

        // Eltároljuk a foglalásokat a kliens oldali kereséshez
        var allBookings = [];

        function loadData() {
            // 1. Workshopok betöltése (Név + Szint formátumban)
            $.ajax({
                url: apiRoot + "WorkshopsList",
                method: "GET",
                beforeSend: sf.setModuleHeaders
            }).done(function(data) {
                var $s = $("#session-ws-id").empty().append("<option value=''>-- Válassz --</option>");
                $.each(data, function(i, v) {
                    var displayText = v.Name + (v.Level ? " (" + v.Level + ")" : "");
                    $s.append($("<option>").val(v.WorkshopID).text(displayText));
                });
            });

            // 2. Foglalások betöltése
            fetchBookings();
        }

        function fetchBookings() {
            $.ajax({
                url: apiRoot + "GetAllBookings",
                method: "GET",
                beforeSend: sf.setModuleHeaders
            }).done(function(data) {
                allBookings = data;
                renderTable(allBookings);
            });
        }

        // Táblázat kirajzolása (keresésnél is ezt használjuk)
        function renderTable(data) {
            var $b = $("#admin-booking-list").empty();
            if(!data || data.length === 0) {
                $b.append("<tr><td colspan='5' style='text-align:center; padding:20px;'>Nincs megjeleníthető foglalás.</td></tr>");
                return;
            }
            $.each(data, function(i, v) {
                var s = v.IsCancelled ? "status-cancelled" : "status-active";
                var dateStr = v.SessionStart ? new Date(v.SessionStart).toLocaleString('hu-HU') : "-";

                var row = "<tr>" +
                    "<td><b>" + dateStr + "</b></td>" +
                    "<td>" + (v.WorkshopName || "Ismeretlen") + "</td>" +
                    "<td>" + (v.Username || "Vendég") + "</td>" +
                    "<td><span class='status-badge " + s + "'>" + (v.IsCancelled ? "Zárt" : "Aktív") + "</span></td>" +
                    "<td>" + (!v.IsCancelled ? "<button type='button' class='btn-delete' onclick='cancelBooking(" + v.BookingID + ")'>Törlés</button>" : "-") + "</td>" +
                    "</tr>";
                $b.append(row);
            });
        }

        // Kliens oldali keresés gépeléskor
        $("#mgmt-search").on("keyup", function() {
            var searchTerm = $(this).val().toLowerCase();
            var filtered = allBookings.filter(function(b) {
                return (b.Username && b.Username.toLowerCase().includes(searchTerm)) ||
                       (b.WorkshopName && b.WorkshopName.toLowerCase().includes(searchTerm));
            });
            renderTable(filtered);
        });

        // Workshop mentése
        $("#btn-save-workshop").click(function() {
            var name = $("#new-ws-name").val();
            if(!name) { alert("Workshop név kötelező!"); return; }

            var d = { Name: name, Level: $("#new-ws-level").val(), Price: 0, Description: "Admin" };
            $.ajax({
                url: apiRoot + "SaveWorkshop",
                method: "POST",
                data: d,
                beforeSend: sf.setModuleHeaders
            }).done(function() {
                alert("Workshop mentve!");
                $("#new-ws-name, #new-ws-level").val("");
                loadData();
            });
        });

        // Időpont mentése (Validációval és Kapacitással)
        $("#btn-save-session").click(function() {
            var wsId = $("#session-ws-id").val();
            var start = $("#session-start").val();
            var capacity = $("#session-capacity").val();

            if(!wsId || !start) { alert("Válassz workshopot és időpontot!"); return; }

            // EGÉSZ ÓRA VALIDÁCIÓ
            var startDate = new Date(start);
            if (startDate.getMinutes() !== 0) {
                alert("Hiba: Csak egész órában kezdődő időpontot rögzíthetsz (pl. 14:00)!");
                return;
            }

            var d = {
                WorkshopID: wsId,
                Start: start,
                Capacity: capacity
            };

            $.ajax({
                url: apiRoot + "SaveSession",
                method: "POST",
                data: d,
                beforeSend: sf.setModuleHeaders
            }).done(function() {
                alert("Időpont rögzítve!");
                $("#session-start").val("");
                fetchBookings();
            }).fail(function(xhr) {
                alert("Hiba a mentés során: " + xhr.status);
            });
        });

        window.cancelBooking = function(id) {
            if(confirm("Biztosan törlöd ezt a foglalást?")) {
                $.ajax({
                    url: apiRoot + "CancelBooking/" + id,
                    method: "POST",
                    beforeSend: sf.setModuleHeaders
                }).done(function() {
                    fetchBookings();
                }).fail(function(xhr) {
                    alert("Hiba a törlés során: " + xhr.status);
                });
            }
        };

        loadData();
    });
</script>