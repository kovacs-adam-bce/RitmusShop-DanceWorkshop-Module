@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage

<div class="dnnForm dnnWorkshopEdit">
    <div class="dnnFormItem">
        <label>Kiválasztott időpont:</label>
        <strong id="display-date"></strong>
    </div>
    <div class="dnnFormItem">
        <label>Workshop típusa:</label>
        <select id="workshop-id" class="dnnFormInput dnnFormRequired"></select>
    </div>
    <div class="dnnFormItem">
        <label>Megjegyzés / Név:</label>
        <input type="text" id="participant-name" class="dnnFormInput" />
    </div>

    <ul class="dnnActions dnnClear">
        <li><a id="save-booking" class="dnnPrimaryAction">Foglalás mentése</a></li> [cite: 8]
        <li><a id="cancel-booking" class="dnnSecondaryAction">Mégse</a></li> [cite: 8]
    </ul>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var mid = parseInt('@Dnn.ModuleContext.ModuleId');
        var sf = $.ServicesFramework(mid);
        var apiRoot = sf.getServiceRoot('DanceWorkShop') + "DanceWorkshopApi/";


        var urlParams = new URLSearchParams(window.location.search);
        var sessionId = parseInt(urlParams.get('sessionId')) || 0;


        var selectedDate = window.parent.currentSelectedSlot; [cite: 9]
        if (selectedDate) {
            $("#display-date").text(new Date(selectedDate).toLocaleString()); [cite: 9, 10]
        }


        $.ajax({
            url: apiRoot + "WorkshopsList",
            method: "GET",
            beforeSend: sf.setModuleHeaders
        }).done(function (data) {
            var select = $("#workshop-id");
            $.each(data, function (i, item) {
                select.append($("<option>").val(item.WorkshopID).text(item.Name)); [cite: 11]
            });
        });

        $("#save-booking").click(function () {
            var bookingData = {
                SessionID: sessionId,
                WorkshopID: $("#workshop-id").val(),
                CreatedAt: new Date().toISOString()
            };

            $.ajax({
                url: apiRoot + "Create", [cite: 13]
                method: "POST",
                data: bookingData,
                beforeSend: sf.setModuleHeaders
            }).done(function () {
                window.parent.location.reload(); [cite: 13]
            }).fail(function (xhr) {
                alert("Hiba: " + xhr.responseText); [cite: 14]
            });
        });

        $("#cancel-booking").click(function () {
            window.parent.dnnModal.closePopUp(false); [cite: 15]
        });
    });
</script>